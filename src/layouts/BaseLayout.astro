---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Revue trimestrielle de réflexion politique, sociale et culturelle.',
} = Astro.props;
const siteTitle = 'Crise Permanente';
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=MedievalSharp&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="flex min-h-screen flex-col text-white">
    <header
      class="sticky top-0 z-50 border-b border-white/10 bg-white/10 backdrop-blur-md"
    >
      <div
        class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4"
      >
        <div>
          <a
            href="/"
            class="font-heading text-xl font-bold tracking-widest uppercase transition-opacity hover:opacity-90"
          >
            Crise Permanente
          </a>
        </div>
        <nav class="flex items-center gap-4">
          <a
            href="/"
            class="rounded border border-transparent px-3 py-1.5 font-sans text-xs font-semibold tracking-widest uppercase transition-colors hover:border-white/25 hover:bg-white/10"
          >
            Numéros
          </a>
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-5xl flex-1 px-6 py-12">
      <slot />
    </main>

    <footer
      class="border-t border-white/10 bg-white/5 px-6 py-8 font-sans text-xs text-white/80 backdrop-blur-md"
    >
      <div
        class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 text-center sm:flex-row sm:text-left"
      >
        <div>
          <strong class="text-white">Crise Permanente</strong> — Pensée critique du
          temps présent.
        </div>
        <div class="text-white/60">
          Revue propulsée par Cloudflare Workers & Decap CMS.
        </div>
      </div>
    </footer>
  </body>
</html>
