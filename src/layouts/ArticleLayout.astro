---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  issueSlug: string;
  issueTitle: string;
  author?: string;
}

const { title, description, publishDate, issueSlug, issueTitle, author } =
  Astro.props;

const formattedDate = new Intl.DateTimeFormat('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(publishDate);
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-2xl border-white/20">
    <nav
      class="mb-8 flex items-center gap-2 font-sans text-xs tracking-wider text-white/60 uppercase"
      aria-label="Fil d'Ariane"
    >
      <a href="/" class="transition-colors hover:text-white">Accueil</a>
      <span>/</span>
      <a
        href={`/numeros/${issueSlug}`}
        class="transition-colors hover:text-white">{issueTitle}</a
      >
      <span>/</span>
      <span class="text-white" aria-current="page">Article</span>
    </nav>

    <header class="mb-10 border-b border-white/20 pb-8">
      <div
        class="mb-3 font-sans text-xs tracking-widest text-white/60 uppercase"
      >
        <time datetime={publishDate.toISOString()}>{formattedDate}</time>
        {author && <span> • Par {author}</span>}
      </div>
      <h1
        class="font-heading mb-4 text-3xl leading-tight font-bold sm:text-4xl"
      >
        {title}
      </h1>
      <p
        class="font-serif text-lg leading-relaxed text-white/80 italic sm:text-xl"
      >
        {description}
      </p>
    </header>

    <div
      class="prose prose-invert prose-lg prose-headings:font-heading prose-headings:text-white prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4 prose-h2:border-b prose-h2:border-white/20 prose-h2:pb-2 prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3 prose-p:leading-relaxed prose-p:mb-6 prose-blockquote:border-l-white prose-blockquote:text-white/90 prose-blockquote:italic max-w-none font-serif text-white/95"
    >
      <slot />
    </div>

    <footer class="mt-12 border-t border-white/20 pt-8">
      <a
        href={`/numeros/${issueSlug}`}
        class="inline-flex items-center gap-2 rounded border border-white/20 bg-white/10 px-4 py-2 font-sans text-xs font-semibold tracking-widest uppercase transition-colors hover:bg-white/20"
      >
        ← Retour au numéro {issueTitle}
      </a>
    </footer>
  </article>
</BaseLayout>
