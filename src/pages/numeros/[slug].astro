---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const issues = await getCollection('issues');
  const allArticles = await getCollection('articles');

  return issues.map((issue) => {
    // Filtrer les articles liés à cette issue via la référence (id)
    const relatedArticles = allArticles.filter(
      (article) => article.data.issue.id === issue.id
    ).sort((a, b) => a.data.publishDate.getTime() - b.data.publishDate.getTime());

    return {
      params: { slug: issue.id },
      props: { issue, articles: relatedArticles },
    };
  });
}

interface Props {
  issue: CollectionEntry<'issues'>;
  articles: CollectionEntry<'articles'>[];
}

const { issue, articles } = Astro.props;
const { Content } = await render(issue);

const formattedDate = new Intl.DateTimeFormat('fr-FR', {
  month: 'long',
  year: 'numeric',
}).format(issue.data.publishDate);
---

<BaseLayout
  title={issue.data.title}
  description={issue.data.description || `Sommaire du numéro ${issue.data.title} de la revue Crise Permanente.`}
>
  <nav class="flex items-center gap-2 font-sans text-xs tracking-wider uppercase text-white/60 mb-8" aria-label="Fil d'Ariane">
    <a href="/" class="hover:text-white transition-colors">Accueil</a>
    <span>/</span>
    <a href="/" class="hover:text-white transition-colors">Numéros</a>
    <span>/</span>
    <span class="text-white" aria-current="page">{issue.data.title}</span>
  </nav>

  <header class="text-center max-w-3xl mx-auto mb-12">
    <div class="font-sans text-xs uppercase tracking-[0.2em] text-white/60 mb-3">
      Édition de {formattedDate} • {issue.data.season} {issue.data.year}
    </div>
    <h1 class="font-heading text-4xl sm:text-5xl font-bold mb-4 leading-tight">
      {issue.data.title}
    </h1>
    {issue.data.description && (
      <p class="font-serif text-lg sm:text-xl text-white/80 italic leading-relaxed">
        {issue.data.description}
      </p>
    )}
  </header>

  <div class="max-w-2xl mx-auto mb-12 bg-white/5 border-l-4 border-white/80 p-6 rounded-r-lg">
    <div class="font-heading text-xs uppercase tracking-widest text-white/60 mb-2 font-semibold">
      Présentation du numéro
    </div>
    <div class="font-serif text-base leading-relaxed text-white/90 space-y-4">
      <Content />
    </div>
  </div>

  <section class="max-w-2xl mx-auto">
    <div class="flex justify-between items-baseline border-b border-white/20 pb-3 mb-6">
      <h2 class="font-heading text-xl uppercase tracking-wider font-semibold">
        Sommaire des articles
      </h2>
      <span class="font-sans text-xs uppercase tracking-widest text-white/60">
        {articles.length} article{articles.length > 1 ? 's' : ''}
      </span>
    </div>

    {articles.length === 0 ? (
      <p class="text-white/60 italic py-8">
        Aucun article n'a encore été publié dans ce numéro.
      </p>
    ) : (
      <div class="flex flex-col gap-6">
        {articles.map((article) => (
          <article class="bg-[#2d0409]/75 hover:bg-[#4a050d]/85 border border-white/20 hover:border-white/40 rounded-xl p-6 transition-all duration-200">
            <div class="font-sans text-xs uppercase tracking-widest text-white/60 mb-2">
              {article.data.author && <span>{article.data.author} • </span>}
              <time datetime={article.data.publishDate.toISOString()}>
                {new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(article.data.publishDate)}
              </time>
            </div>
            <h3 class="font-heading text-xl font-bold mb-2">
              <a href={`/articles/${article.id}`} class="hover:text-white/90">
                {article.data.title}
              </a>
            </h3>
            <p class="font-serif text-sm sm:text-base text-white/80 leading-relaxed mb-4">
              {article.data.description}
            </p>
            <div>
              <a
                href={`/articles/${article.id}`}
                class="inline-flex items-center gap-1.5 font-sans text-xs uppercase tracking-widest font-semibold pb-0.5 border-b border-white hover:text-white/80 hover:border-white/70 transition-colors"
              >
                Lire l'article →
              </a>
            </div>
          </article>
        ))}
      </div>
    )}

    <div class="mt-12">
      <a
        href="/"
        class="inline-flex items-center gap-2 font-sans text-xs uppercase tracking-widest font-semibold px-4 py-2 rounded border border-white/20 bg-white/10 hover:bg-white/20 transition-colors"
      >
        ← Tous les numéros
      </a>
    </div>
  </section>
</BaseLayout>
