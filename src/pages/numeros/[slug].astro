---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const issues = await getCollection('issues');
  const allArticles = await getCollection('articles');

  return issues.map((issue) => {
    // Filtrer les articles liés à cette issue via la référence (id)
    const relatedArticles = allArticles.filter(
      (article) => article.data.issue.id === issue.id
    ).sort((a, b) => a.data.publishDate.getTime() - b.data.publishDate.getTime());

    return {
      params: { slug: issue.id },
      props: { issue, articles: relatedArticles },
    };
  });
}

interface Props {
  issue: CollectionEntry<'issues'>;
  articles: CollectionEntry<'articles'>[];
}

const { issue, articles } = Astro.props;
const { Content } = await render(issue);

const formattedDate = new Intl.DateTimeFormat('fr-FR', {
  month: 'long',
  year: 'numeric',
}).format(issue.data.publishDate);
---

<BaseLayout
  title={issue.data.title}
  description={issue.data.description || `Sommaire du numéro ${issue.data.title} de la revue Crise Permanente.`}
>
  <nav class="breadcrumbs" aria-label="Fil d'Ariane">
    <a href="/">Accueil</a>
    <span>/</span>
    <a href="/">Numéros</a>
    <span>/</span>
    <span aria-current="page">{issue.data.title}</span>
  </nav>

  <header style="margin-bottom: 3.5rem; text-align: center; max-width: 780px; margin-left: auto; margin-right: auto;">
    <div style="font-family: var(--font-sans); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.2em; color: var(--color-text-faint); margin-bottom: 0.75rem;">
      Édition de {formattedDate} • {issue.data.season} {issue.data.year}
    </div>
    <h1 style="font-family: var(--font-heading); font-size: 2.8rem; line-height: 1.15; margin-bottom: 1.25rem;">
      {issue.data.title}
    </h1>
    {issue.data.description && (
      <p style="font-size: 1.25rem; font-style: italic; color: var(--color-text-muted); line-height: 1.6;">
        {issue.data.description}
      </p>
    )}
  </header>

  <div style="max-width: var(--max-width-article); margin: 0 auto 3rem; background: var(--color-surface); padding: 2rem; border-radius: var(--radius-md); border-left: 3px solid rgba(255,255,255,0.7);">
    <div style="font-family: var(--font-heading); font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.75rem; color: var(--color-text-faint);">
      Présentation du numéro
    </div>
    <div class="prose" style="font-size: 1.05rem;">
      <Content />
    </div>
  </div>

  <section style="max-width: var(--max-width-article); margin: 0 auto;">
    <div style="display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid var(--color-border); padding-bottom: 0.75rem; margin-bottom: 1.5rem;">
      <h2 style="font-family: var(--font-heading); font-size: 1.35rem; letter-spacing: 0.08em; text-transform: uppercase;">
        Sommaire des articles
      </h2>
      <span style="font-family: var(--font-sans); font-size: 0.8rem; color: var(--color-text-faint);">
        {articles.length} article{articles.length > 1 ? 's' : ''}
      </span>
    </div>

    {articles.length === 0 ? (
      <p style="color: var(--color-text-muted); font-style: italic; padding: 2rem 0;">
        Aucun article n'a encore été publié dans ce numéro.
      </p>
    ) : (
      <div class="articles-list">
        {articles.map((article) => (
          <article class="article-item">
            <div class="article-item-meta">
              {article.data.author && <span>{article.data.author} • </span>}
              <time datetime={article.data.publishDate.toISOString()}>
                {new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(article.data.publishDate)}
              </time>
            </div>
            <h3 class="article-item-title">
              <a href={`/articles/${article.id}`}>{article.data.title}</a>
            </h3>
            <p class="article-item-chapo">{article.data.description}</p>
            <div style="margin-top: 1.25rem;">
              <a href={`/articles/${article.id}`} class="issue-card-link">
                Lire l'article →
              </a>
            </div>
          </article>
        ))}
      </div>
    )}

    <div style="margin-top: 3.5rem;">
      <a href="/" class="back-link">
        ← Tous les numéros
      </a>
    </div>
  </section>
</BaseLayout>
