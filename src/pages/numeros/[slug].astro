---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const issues = await getCollection('issues');
  const allArticles = await getCollection('articles');

  return issues.map(issue => {
    // Filtrer les articles liés à cette issue via la référence (id)
    const relatedArticles = allArticles
      .filter(article => article.data.issue.id === issue.id)
      .sort(
        (a, b) => a.data.publishDate.getTime() - b.data.publishDate.getTime()
      );

    return {
      params: { slug: issue.id },
      props: { issue, articles: relatedArticles },
    };
  });
}

interface Props {
  issue: CollectionEntry<'issues'>;
  articles: CollectionEntry<'articles'>[];
}

const { issue, articles } = Astro.props;
const { Content } = await render(issue);

const formattedDate = new Intl.DateTimeFormat('fr-FR', {
  month: 'long',
  year: 'numeric',
}).format(issue.data.publishDate);
---

<BaseLayout
  title={issue.data.title}
  description={issue.data.description ||
    `Sommaire du numéro ${issue.data.title} de la revue Crise Permanente.`}
>
  <nav
    class="mb-8 flex items-center gap-2 font-sans text-xs tracking-wider text-white/60 uppercase"
    aria-label="Fil d'Ariane"
  >
    <a href="/" class="transition-colors hover:text-white">Accueil</a>
    <span>/</span>
    <a href="/" class="transition-colors hover:text-white">Numéros</a>
    <span>/</span>
    <span class="text-white" aria-current="page">{issue.data.title}</span>
  </nav>

  <header class="mx-auto mb-12 max-w-3xl text-center">
    <div
      class="mb-3 font-sans text-xs tracking-[0.2em] text-white/60 uppercase"
    >
      Édition de {formattedDate} • {issue.data.season}
      {issue.data.year}
    </div>
    <h1 class="font-heading mb-4 text-4xl leading-tight font-bold sm:text-5xl">
      {issue.data.title}
    </h1>
    {
      issue.data.description && (
        <p class="font-serif text-lg leading-relaxed text-white/80 italic sm:text-xl">
          {issue.data.description}
        </p>
      )
    }
  </header>

  <div
    class="mx-auto mb-12 max-w-2xl rounded-r-lg border-l-4 border-white/60 bg-white/10 p-6 backdrop-blur-sm"
  >
    <div
      class="font-heading mb-2 text-xs font-semibold tracking-widest text-white/60 uppercase"
    >
      Présentation du numéro
    </div>
    <div
      class="prose prose-invert prose-p:mb-4 max-w-none font-serif text-base leading-relaxed text-white/90"
    >
      <Content />
    </div>
  </div>

  <section class="mx-auto max-w-2xl">
    <div
      class="mb-6 flex items-baseline justify-between border-b border-white/20 pb-3"
    >
      <h2 class="font-heading text-xl font-semibold tracking-wider uppercase">
        Sommaire des articles
      </h2>
      <span class="font-sans text-xs tracking-widest text-white/60 uppercase">
        {articles.length} article{articles.length > 1 ? 's' : ''}
      </span>
    </div>

    {
      articles.length === 0 ? (
        <p class="py-8 text-white/60 italic">
          Aucun article n'a encore été publié dans ce numéro.
        </p>
      ) : (
        <div class="flex flex-col gap-6">
          {articles.map(article => (
            <article class="rounded-xl border border-white/15 bg-white/10 p-6 backdrop-blur-sm transition-all duration-200 hover:border-white/30 hover:bg-white/15">
              <div class="mb-2 font-sans text-xs tracking-widest text-white/60 uppercase">
                {article.data.author && <span>{article.data.author} • </span>}
                <time datetime={article.data.publishDate.toISOString()}>
                  {new Intl.DateTimeFormat('fr-FR', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                  }).format(article.data.publishDate)}
                </time>
              </div>
              <h3 class="font-heading mb-2 text-xl font-bold">
                <a href={`/articles/${article.id}`} class="hover:text-white/90">
                  {article.data.title}
                </a>
              </h3>
              <p class="mb-4 font-serif text-sm leading-relaxed text-white/80 sm:text-base">
                {article.data.description}
              </p>
              <div>
                <a
                  href={`/articles/${article.id}`}
                  class="inline-flex items-center gap-1.5 border-b border-white pb-0.5 font-sans text-xs font-semibold tracking-widest uppercase transition-colors hover:border-white/70 hover:text-white/80"
                >
                  Lire l'article →
                </a>
              </div>
            </article>
          ))}
        </div>
      )
    }

    <div class="mt-12">
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded border border-white/20 bg-white/10 px-4 py-2 font-sans text-xs font-semibold tracking-widest uppercase transition-colors hover:bg-white/20"
      >
        ← Tous les numéros
      </a>
    </div>
  </section>
</BaseLayout>
