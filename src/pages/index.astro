---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const issues = await getCollection('issues');
// Tri du plus récent au plus ancien par date de publication
const sortedIssues = issues.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<BaseLayout title="Crise Permanente">
  <section class="my-10 py-6 text-center">
    <h1
      class="font-heading mb-4 text-4xl font-extrabold tracking-wider uppercase drop-shadow-sm sm:text-5xl"
    >
      Crise Permanente
    </h1>
    <p
      class="mx-auto max-w-2xl font-serif text-lg leading-relaxed text-white/80 italic sm:text-xl"
    >
      Revue trimestrielle de critique sociale, politique et écologique.
      Chroniques d'une époque qui a érigé l'urgence en méthode de gouvernement.
    </p>
  </section>

  <section class="mt-8">
    <div
      class="mb-8 flex items-baseline justify-between border-b border-white/20 pb-3"
    >
      <h2 class="font-heading text-xl font-semibold tracking-wider uppercase">
        Numéros parus
      </h2>
      <span class="font-sans text-xs tracking-widest text-white/60 uppercase">
        {sortedIssues.length} publication{sortedIssues.length > 1 ? 's' : ''}
      </span>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      {
        sortedIssues.map(issue => (
          <article class="flex flex-col justify-between rounded-xl border border-white/20 bg-[#2d0409]/75 p-8 shadow-xl transition-all duration-200 hover:-translate-y-1 hover:border-white/40 hover:bg-[#4a050d]/85">
            <div>
              <div class="mb-3 flex items-center gap-2 font-sans text-xs tracking-widest text-white/60 uppercase">
                <span>Année {issue.data.year}</span>
                <span>•</span>
                <span class="capitalize">{issue.data.season}</span>
              </div>
              <h3 class="font-heading mb-3 text-2xl leading-snug font-bold">
                {issue.data.title}
              </h3>
              {issue.data.description && (
                <p class="mb-6 font-serif text-base leading-relaxed text-white/80">
                  {issue.data.description}
                </p>
              )}
            </div>
            <div>
              <a
                href={`/numeros/${issue.id}`}
                class="inline-flex items-center gap-2 border-b border-white pb-1 font-sans text-xs font-semibold tracking-widest uppercase transition-colors hover:border-white/70 hover:text-white/80"
              >
                Consulter le numéro →
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
